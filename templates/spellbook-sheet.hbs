<div class="npc-spellbook-container">
  <header class="sheet-header">
    <h2 class="item-name">{{item.name}}</h2>
    <div class="header-actions">
      <button type="button" data-action="studySpellbook" class="btn-study">
        <i class="fas fa-graduation-cap"></i> Study Spellbook
      </button>
    </div>
  </header>

  <section class="spells-list">
    {{#if hasSpells}}
      {{#each spellLevels}}
        <div class="spell-level-header">
          <h3>{{this.label}}</h3>
        </div>
        <ul class="spell-items">
          {{#each this.spells}}
            <li class="spell-row" data-spell-id="{{this.id}}">
              <img class="spell-img" src="{{this.img}}" width="28" height="28" alt="{{this.name}}"/>
              <span class="spell-title">{{this.name}}</span>
              <button type="button" class="btn-delete" data-action="deleteSpell" data-spell-id="{{this.id}}" title="Remove Spell">
                <i class="fas fa-trash"></i>
              </button>
            </li>
          {{/each}}
        </ul>
      {{/each}}
    {{else}}
      <p class="empty-notice">No spells inside this spellbook. Drag and drop spell items here to add them.</p>
    {{/if}}
  </section>
</div>
