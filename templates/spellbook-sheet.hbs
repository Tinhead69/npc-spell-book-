<form class="{{cssClass}}" autocomplete="off">
  <!-- Header Section -->
  <header class="sheet-header">
    <h1 class="item-name">{{item.name}}</h1>
    <div class="header-actions">
      <button type="button" class="btn add-spell-btn"><i class="fas fa-plus"></i> Add Spell</button>
      <button type="button" class="btn study-spellbook-btn"><i class="fas fa-book-reader"></i> Study Spellbook</button>
    </div>
  </header>

  <!-- Main Content Scroll Area -->
  <section class="sheet-body spellbook-body">
    {{#each activeLevels as |group level|}}
      <div class="level-group">
        <!-- Header Bar with Integrated Column Titles (Image 2 style) -->
        <div class="level-header">
          <span class="level-title">
            {{#if (eq level "0")}}Cantrips{{else}}LEVEL {{level}}{{/if}}
          </span>
          <div class="header-columns">
            <span class="col-time">TIME</span>
            <span class="col-range">RANGE</span>
            <span class="col-target">TARGET</span>
            <span class="col-actions"></span>
          </div>
        </div>

        <!-- List of Spells -->
        <div class="spell-list">
          {{#each group.spells as |spell|}}
            <div class="spell-row" data-spell-id="{{spell._id}}">
              <!-- Icon & Name/Components -->
              <div class="col-name">
                <img class="spell-icon" src="{{spell.img}}" title="{{spell.name}}"/>
                <div class="spell-details">
                  <span class="spell-title">{{spell.name}}</span>
                  {{#if spell.system.components.vsm}}
                    <span class="spell-components">{{spell.system.components.vsm}}</span>
                  {{/if}}
                </div>
              </div>

              <!-- Spell Attributes -->
              <span class="col-time">{{#if spell.system.activation.type}}{{spell.system.activation.type}}{{else}}—{{/if}}</span>
              <span class="col-range">{{#if spell.system.range.value}}{{spell.system.range.value}}{{else}}—{{/if}}</span>
              <span class="col-target">{{#if spell.system.target.type}}{{spell.system.target.type}}{{else}}—{{/if}}</span>

              <!-- Action Icons -->
              <div class="col-actions">
                <a class="spell-delete" title="Delete Spell"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    {{else}}
      <div class="empty-notice">
        <p>No spells recorded in this spellbook.</p>
      </div>
    {{/each}}
  </section>
</form>
