/* Container Layout */
.study-spellbook .window-content {
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  padding: 8px;
}

/* Toolbar Flex Layout */
.study-spellbook .study-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  margin: 6px 0 10px 0;
  padding: 4px 8px;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}

.study-spellbook .study-toolbar .sort-label {
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase;
  color: var(--color-text-light, #ddd);
  white-space: nowrap;
}

.study-spellbook .study-toolbar .btn-group {
  display: flex;
  flex-direction: row;
  gap: 4px;
}

.study-spellbook .study-toolbar button.sort-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  width: auto;
  margin: 0;
  padding: 2px 8px;
  font-size: 11px;
  line-height: 1.2;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #ccc;
  border-radius: 3px;
  cursor: pointer;
}

.study-spellbook .study-toolbar button.sort-btn:hover {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.study-spellbook .study-toolbar button.sort-btn.active {
  background: #7a200d;
  color: #ffffff;
  border-color: #ff6448;
}
