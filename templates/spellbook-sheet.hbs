<div class="npc-spellbook-container flexcol">
  
  <!-- ITEM HEADER: ICON & TITLE -->
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'NPC_SPELLBOOK.PlaceholderName'}}" />
      </h1>
    </div>
  </header>

  <!-- ACTION BUTTONS TOOLBAR -->
  <div class="sheet-actions">
    <button type="button" class="add-spell-btn" data-action="addSpell">
      <i class="fas fa-plus"></i> {{localize "NPC_SPELLBOOK.Actions.AddSpell"}}
    </button>
    
    <button type="button" class="clear-spellbook-btn" data-action="clearSpellbook">
      <i class="fas fa-trash"></i> {{localize "NPC_SPELLBOOK.Actions.ClearSpellbook"}}
    </button>

    <button type="button" class="study-spellbook-btn" data-action="studySpellbook">
      <i class="fas fa-book"></i> {{localize "NPC_SPELLBOOK.Actions.StudySpellbook"}}
    </button>
  </div>

  <!-- SPELL LIST CONTAINER -->
  <section class="sheet-body">
    {{#if spellLevels}}
      <div class="spells-list">
        {{#each spellLevels as |spells level|}}
          <div class="spell-level-block">
            
            <!-- CRIMSON HEADER BAR -->
            <div class="spell-level-header">
              {{#if (eq level 0)}}
                {{localize "NPC_SPELLBOOK.Cantrips"}}
              {{else}}
                {{localize "NPC_SPELLBOOK.Level" level=level}}
              {{/if}}
            </div>

            <!-- SPELLS TABLE -->
            <table class="spells-table">
              <thead>
                <tr>
                  <th class="col-name">{{localize "NPC_SPELLBOOK.Headers.Name"}}</th>
                  <th class="col-actions"></th>
                </tr>
              </thead>
              <tbody>
                {{#each spells as |spell|}}
                  <tr class="spell-item" data-spell-id="{{spell.id}}" data-spell-name="{{spell.name}}">
                    <td class="col-name">
                      <div class="spell-name-cell">
                        <img src="{{spell.img}}" class="spell-icon" alt="{{spell.name}}" />
                        <div class="spell-details">
                          <span class="spell-title">{{spell.name}}</span>
                          {{#if spell.components}}
                            <span class="spell-components">{{spell.components}}</span>
                          {{/if}}
                        </div>
                      </div>
                    </td>
                    <td class="col-actions">
                      <a class="delete-spell" data-action="deleteSpell" data-spell-id="{{spell.id}}" title="{{localize 'NPC_SPELLBOOK.Actions.DeleteSpell'}}">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>

          </div>
        {{/each}}
      </div>
    {{else}}
      <!-- EMPTY STATE -->
      <div class="empty-notice" style="text-align: center; margin-top: 3rem; opacity: 0.6; font-size: 0.9rem;">
        <i class="fas fa-book-open" style="font-size: 2rem; display: block; margin-bottom: 0.5rem;"></i>
        {{localize "NPC_SPELLBOOK.EmptyNotice"}}
      </div>
    {{/if}}
  </section>

</div>