<form class="{{cssClass}} flexcol" autocomplete="off">
  <!-- Header / Action Buttons -->
  <header class="sheet-header flexrow" style="align-items: center; margin-bottom: 8px; gap: 8px;">
    <img src="{{#if img}}{{img}}{{else}}icons/svg/book.svg{{/if}}" data-edit="img" alt="{{name}}" width="40" height="40" style="flex: 0 0 40px; border-radius: 4px; object-fit: contain; cursor: pointer;" title="Click to change image" />
    <div style="flex: 1; font-size: 1.1rem; font-weight: bold;">{{name}}</div>
    <div style="display: flex; gap: 4px;">
      <button type="button" class="add-spell-btn" style="padding: 2px 8px; font-size: 0.8rem;">
        <i class="fas fa-plus"></i> Add Spell
      </button>
      <button type="button" class="clear-book-btn" style="padding: 2px 6px; font-size: 0.8rem; color: var(--color-level-error, #aa0000);" title="Clear Spellbook">
        <i class="fas fa-trash"></i>
      </button>
    </div>
  </header>

  <!-- Spell List Body Grouped by Level -->
  <section class="sheet-body" style="flex: 1; overflow-y: auto; max-height: 520px;">
    <ol class="items-list inventory-list directory-list">
      {{#if hasSpells}}
        {{#each activeLevels}}
          <!-- Standard dnd5e Item Header Bar -->
          <li class="item-header flexrow">
            <div class="item-name" style="flex: 1;">{{label}}</div>
            <div class="item-detail" style="width: 75px; text-align: center;">ACTIVATION</div>
            <div class="item-detail" style="width: 65px; text-align: center;">RANGE</div>
            <div class="item-detail" style="width: 80px; text-align: center;">TARGET</div>
            <div class="item-detail" style="width: 55px; text-align: center;">COMP</div>
            <div class="item-detail" style="width: 75px; text-align: center;">DURATION</div>
            <div class="item-controls" style="width: 40px; text-align: right;"></div>
          </li>

          <ol class="item-list" style="list-style: none; padding: 0; margin: 0 0 8px 0;">
            {{#each spells}}
              <li class="item flexrow" style="align-items: center; padding: 3px 4px;">
                <div class="item-name flexrow" style="flex: 1; align-items: center; gap: 6px;">
                  <img src="{{img}}" alt="{{name}}" width="24" height="24" style="width: 24px; height: 24px; flex: 0 0 24px; border-radius: 3px; object-fit: contain;" />
                  <span class="spell-name" style="font-weight: 500;">{{name}}</span>
                </div>
                <div class="item-detail" style="width: 75px; text-align: center; font-size: 0.85rem;" title="{{castTime}}">
                  {{castTime}}
                </div>
                <div class="item-detail" style="width: 65px; text-align: center; font-size: 0.85rem;" title="{{range}}">
                  {{range}}
                </div>
                <div class="item-detail" style="width: 80px; text-align: center; font-size: 0.85rem;" title="{{target}}">
                  {{target}}
                </div>
                <div class="item-detail" style="width: 55px; text-align: center; font-size: 0.85rem;" title="{{components}}">
                  {{components}}
                </div>
                <div class="item-detail" style="width: 75px; text-align: center; font-size: 0.85rem;" title="{{duration}}">
                  {{duration}}
                </div>
                <div class="item-controls" style="width: 40px; text-align: right;">
                  <button type="button" class="remove-spell-btn" data-uuid="{{uuid}}" style="background: none; border: none; cursor: pointer; color: var(--color-level-error, #aa0000);" title="Remove Spell">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </li>
            {{/each}}
          </ol>
        {{/each}}
      {{else}}
        <p class="notes" style="text-align: center; padding: 2rem;">This spellbook is empty. Click "Add Spell" to add spells.</p>
      {{/if}}
    </ol>
  </section>
</form>
