<div class="study-spellbook-container">
  <!-- Wizard Selector Row ... -->

  <!-- ADD THIS SORT TOOLBAR -->
  <div class="study-toolbar flexrow">
    <span class="sort-label">Sort By:</span>
    <div class="btn-group">
      <button type="button" 
              class="btn {{#if (eq currentSort 'level')}}active{{/if}}" 
              data-action="sortSpells" 
              data-sort="level">
        <i class="fas fa-layer-group"></i> Level
      </button>

      <button type="button" 
              class="btn {{#if (eq currentSort 'name')}}active{{/if}}" 
              data-action="sortSpells" 
              data-sort="name">
        <i class="fas fa-sort-alpha-down"></i> Name
      </button>

      <button type="button" 
              class="btn {{#if (eq currentSort 'availability')}}active{{/if}}" 
              data-action="sortSpells" 
              data-sort="availability">
        <i class="fas fa-check-circle"></i> Available
      </button>
    </div>
  </div>

  <!-- Existing Spells Table / List loop ... -->
  <div class="spells-list">
    {{#each spells}}
      <!-- your existing spell row rendering -->
    {{/each}}
  </div>
</div>
