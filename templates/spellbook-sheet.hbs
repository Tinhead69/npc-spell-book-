<form class="npc-spellbook-sheet {{cssClass}}" autocomplete="off">
  <!-- Header Section -->
  <header class="spellbook-header">
    <button type="button" class="img-button" data-action="editImage">
      <img class="profile-img" src="{{item.img}}" title="{{item.name}}" />
    </button>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Spellbook Name" />
      </h1>
      <p class="description">This spellbook is independent of character spellbooks. Wizards may transcribe spells using 5e 2014 rules.</p>
    </div>
  </header>

  <!-- Controls Bar -->
  <div class="spellbook-toolbar flexrow">
    <button type="button" class="btn" data-action="addSpell">
      <i class="fas fa-plus"></i> Add Spell
    </button>
    <button type="button" class="btn" data-action="studySpellbook">
      <i class="fas fa-book-reader"></i> Study Spellbook
    </button>
  </div>

  <!-- Main Spells Content -->
  <div class="spellbook-body">
    {{#if groupedSpells.length}}
      {{#each groupedSpells}}
        <div class="spell-group">
          <div class="spell-header flexrow">
            <span class="group-label">{{this.label}}</span>
            <span class="column-title spell-time">TIME</span>
            <span class="column-title spell-range">RANGE</span>
            <span class="column-title spell-target">TARGET</span>
            <span class="column-title spell-roll">ROLL</span>
            <span class="column-title spell-actions"></span>
          </div>

          <ul class="spell-list">
            {{#each this.spells}}
              <li class="spell-entry flexrow" data-entry-id="{{this.uuid}}">
                <div class="item-name">
                  <img class="item-image" src="{{this.img}}" width="32" height="32" />
                  <div class="name-container">
                    <span class="spell-name">{{this.name}}</span>
                  </div>
                </div>
                <div class="spell-time">-</div>
                <div class="spell-range">-</div>
                <div class="spell-target">-</div>
                <div class="spell-roll">-</div>
                <div class="spell-actions">
                  <button type="button" class="remove-spell" data-action="removeSpell" title="Delete">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    {{else}}
      <div class="spellbook-drop-zone flexcol flex-center">
        <p>Drag and drop spells here to add them to this spellbook.</p>
      </div>
    {{/if}}
  </div>
</form>
