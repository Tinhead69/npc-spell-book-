import { getSpellbookSpells, setSpellbookSpells, MODULE_ID } from "./data.js";

export class NpcSpellbookSheet extends ItemSheet {
  static get defaultOptions() {
    return foundry.utils.mergeObject(super.defaultOptions, {
      classes: ["npc-spellbook", "sheet", "item"],
      template: "modules/npc-spell-book/templates/spellbook-sheet.hbs",
      width: 600,
      height: 600,
      submitOnChange: true,
      closeOnSubmit: false
    });
  }

  async getData(options) {
    const context = await super.getData(options);
    context.item = this.item;
    context.isGM = game.user.isGM;
    
    // Group spells by level
    const spells = getSpellbookSpells(this.item);
    const levels = {};
    for (const spell of spells) {
      const lvl = spell.level ?? 0;
      if (!levels[lvl]) levels[lvl] = [];
      levels[lvl].push(spell);
    }
    context.spellLevels = levels;

    return context;
  }

  activateListeners(html) {
    super.activateListeners(html);

    // Delete spell listener
    html.find(".delete-spell").click(async (event) => {
      event.preventDefault();
      const spellId = event.currentTarget.dataset.spellId;
      let spells = getSpellbookSpells(this.item);
      spells = spells.filter((s) => s.id !== spellId && s.uuid !== spellId);
      await setSpellbookSpells(this.item, spells);
      this.render(false);
    });
  }

  /**
   * Process and update object properties when form changes occur (e.g. updating the name)
   */
  async _updateObject(event, formData) {
    return this.object.update(formData);
  }
}
