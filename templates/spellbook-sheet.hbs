<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header flexrow">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Spellbook Name"/>
      </h1>
      <p class="notes">
        This spellbook is independent of character spellbooks. Wizards may transcribe spells using 5e 2014 rules.
      </p>
    </div>
  </header>

  <section class="sheet-body flexcol">
    <div class="sheet-actions flexrow">
      {{#if isGM}}
        <button type="button" class="add-spell"><i class="fas fa-plus"></i> Add Spell</button>
      {{/if}}
      <button type="button" class="study-spellbook"><i class="fas fa-scroll"></i> Study Spellbook</button>
    </div>

    <div class="spells-list">
      {{#each spellLevels as |spells level|}}
        <div class="spell-level-header">
          <h3>{{#if (eq level 0)}}Cantrips{{else}}Level {{level}}{{/if}}</h3>
        </div>
        <table class="spells-table">
          <thead>
            <tr>
              <th class="spell-name">Name</th>
              <th class="spell-time">Time</th>
              <th class="spell-range">Range</th>
              <th class="spell-target">Target</th>
              <th class="spell-actions"></th>
            </tr>
          </thead>
          <tbody>
            {{#each spells as |spell|}}
              <tr class="spell-item" data-spell-id="{{spell.id}}">
                <td class="spell-name flexrow">
                  <img src="{{spell.img}}" class="spell-icon" width="24" height="24"/>
                  <span>{{spell.name}}</span>
                </td>
                <td class="spell-time">{{spell.activation.cost}} {{spell.activation.type}}</td>
                <td class="spell-range">{{spell.range.value}} {{spell.range.units}}</td>
                <td class="spell-target">{{spell.target.value}} {{spell.target.units}}</td>
                <td class="spell-actions">
                  <a class="delete-spell" data-spell-id="{{spell.id}}" title="Delete Spell">
                    <i class="fas fa-trash"></i>
                  </a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p class="empty-notice">No spells recorded in this spellbook yet. Drop spell items here to add them.</p>
      {{/each}}
    </div>
  </section>
</form>
