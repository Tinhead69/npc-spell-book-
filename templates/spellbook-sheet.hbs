<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header" style="display: flex; gap: 10px; align-items: center; margin-bottom: 10px;">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" width="64" height="64" style="border-radius: 4px; object-fit: cover;"/>
    <div class="header-fields" style="flex: 1;">
      <h1 class="charname" style="margin: 0;"><input name="name" type="text" value="{{item.name}}" placeholder="Spellbook Name"/></h1>
    </div>
  </header>

  <!-- ACTION BUTTONS ROW (3 EQUALLY SPACED BUTTONS) -->
  <div class="spellbook-actions" style="display: flex; gap: 6px; margin-bottom: 10px; width: 100%;">
    {{#if isGM}}
      <button type="button" class="add-spell-btn" style="flex: 1; padding: 4px 8px; font-size: 11px; display: flex; align-items: center; justify-content: center; gap: 4px; white-space: nowrap;">
        <i class="fas fa-plus"></i> Add Spell
      </button>
      <button type="button" class="clear-spellbook-btn" data-action="clearSpellbook" style="flex: 1; padding: 4px 8px; font-size: 11px; display: flex; align-items: center; justify-content: center; gap: 4px; white-space: nowrap;">
        <i class="fas fa-trash-alt"></i> Clear Spellbook
      </button>
    {{/if}}
    <button type="button" class="study-spellbook-btn" data-action="studySpellbook" style="flex: 1; padding: 4px 8px; font-size: 11px; display: flex; align-items: center; justify-content: center; gap: 4px; white-space: nowrap;">
      <i class="fas fa-book-open"></i> Study Spellbook
    </button>
  </div>

  <section class="sheet-body">
    <div class="spells-list">
      {{#each spellLevels as |spells level|}}
        <div class="spell-level-group" style="margin-bottom: 12px;">
          <h3 style="border-bottom: 1px solid #7a7971; margin: 0 0 4px 0; padding-bottom: 2px; font-size: 13px;">
            Level {{level}}
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px;">
            {{#each spells}}
              <li data-spell-id="{{this.id}}" data-spell-name="{{this.name}}" style="display: flex; align-items: center; justify-content: space-between; padding: 2px 6px; background: rgba(0,0,0,0.04); border-radius: 3px; font-size: 11px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                  <img src="{{this.img}}" width="20" height="20" style="border: none; border-radius: 2px;" />
                  <span><strong>{{this.name}}</strong></span>
                </div>
                {{#if ../../isGM}}
                  <a class="delete-spell" data-action="deleteSpell" title="Delete Spell" style="cursor: pointer; color: #a00;">
                    <i class="fas fa-trash"></i>
                  </a>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    </div>
  </section>
</form>
