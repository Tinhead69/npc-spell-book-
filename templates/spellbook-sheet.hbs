<div class="spellbook-sheet-container" style="display: flex; flex-direction: column; height: 100%; font-family: sans-serif;">
  <!-- Header Controls -->
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px; background: #1a1a1a; border-bottom: 1px solid #333;">
    <!-- Book Name Field (Bound to Item Name) -->
    <div style="display: flex; align-items: center; gap: 6px; flex: 1;">
      <label style="font-size: 0.8rem; color: #aaaaaa; white-space: nowrap; font-weight: bold;">Book Name:</label>
      <input type="text" name="name" value="{{name}}" placeholder="Spellbook Name" style="background: #2b2b2b; border: 1px solid #444; color: #fff; padding: 4px 8px; border-radius: 3px; font-size: 0.85rem; width: 100%;" />
    </div>

    <!-- Action Buttons -->
    <div style="display: flex; gap: 6px; align-items: center;">
      <button type="button" data-action="addSpell" style="background: #3a5a3a; color: #fff; border: 1px solid #5a8a5a; border-radius: 3px; padding: 4px 10px; cursor: pointer; font-size: 0.8rem;">
        <i class="fas fa-plus"></i> Add Spells
      </button>
      <button type="button" data-action="clearBook" style="background: #5a3a3a; color: #fff; border: 1px solid #8a5a5a; border-radius: 3px; padding: 4px 10px; cursor: pointer; font-size: 0.8rem;">
        <i class="fas fa-trash"></i> Clear Book
      </button>
    </div>
  </div>

  <!-- Spells List Area -->
  <div style="flex: 1; overflow-y: auto; padding: 8px;">
    {{#if hasSpells}}
      {{#each activeLevels}}
        <div class="spell-level-group" style="margin-bottom: 16px;">
          <div style="font-weight: bold; font-size: 0.85rem; color: #c9c7b8; background: #222; padding: 4px 8px; border-left: 3px solid #7a2020; margin-bottom: 6px; text-transform: uppercase;">
            {{label}}
          </div>
          <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
            <thead>
              <tr style="border-bottom: 1px solid #444; text-align: left; color: #888;">
                <th style="padding: 4px;">Spell</th>
                <th style="padding: 4px;">Casting Time</th>
                <th style="padding: 4px;">Range</th>
                <th style="padding: 4px;">Target</th>
                <th style="padding: 4px;">Comp.</th>
                <th style="padding: 4px;">Duration</th>
                <th style="padding: 4px; text-align: center; width: 30px;"></th>
              </tr>
            </thead>
            <tbody>
              {{#each spells}}
                <tr style="border-bottom: 1px solid #2a2a2a;">
                  <td style="padding: 4px; display: flex; align-items: center; gap: 6px;">
                    <img src="{{img}}" width="20" height="20" style="border: none; border-radius: 2px;" />
                    <span style="font-weight: 500;">{{name}}</span>
                  </td>
                  <td style="padding: 4px; color: #ccc;">{{castTime}}</td>
                  <td style="padding: 4px; color: #ccc;">{{range}}</td>
                  <td style="padding: 4px; color: #ccc;">{{target}}</td>
                  <td style="padding: 4px; color: #ccc;">{{components}}</td>
                  <td style="padding: 4px; color: #ccc;">{{duration}}</td>
                  <td style="padding: 4px; text-align: center;">
                    <a data-action="removeSpell" data-uuid="{{uuid}}" title="Remove Spell" style="color: #a33535; cursor: pointer;">
                      <i class="fas fa-trash"></i>
                    </a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{/each}}
    {{else}}
      <div style="text-align: center; padding: 40px; color: #777; font-style: italic;">
        This spellbook is currently empty. Click "Add Spells" to add spells to this book.
      </div>
    {{/if}}
  </div>
</div>
