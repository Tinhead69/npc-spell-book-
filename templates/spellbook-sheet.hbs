<form class="{{cssClass}} flexcol spellbook-sheet" autocomplete="off">

  {{!-- Header: Spellcasting Overview --}}
  <header class="sheet-header flexrow">
    <div class="profile-img-container">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    </div>

    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name" />
      </h1>

      <div class="stats-grid">
        <div class="stat-box">
          <label>Casting Ability</label>
          <select name="system.attributes.spellcasting">
            {{#select system.attributes.spellcasting}}
              <option value="int">Intelligence</option>
              <option value="wis">Wisdom</option>
              <option value="cha">Charisma</option>
            {{/select}}
          </select>
        </div>

        <div class="stat-box">
          <label>Spell DC</label>
          <input type="number" name="system.attributes.spelldc" value="{{system.attributes.spelldc}}" />
        </div>

        <div class="stat-box">
          <label>Attack Bonus</label>
          <input type="number" name="system.attributes.spellmod" value="{{system.attributes.spellmod}}" />
        </div>
      </div>
    </div>
  </header>

  {{!-- Main Spellbook Section --}}
  <section class="sheet-body">
    <div class="spellbook-controls flexrow">
      <div class="filter-group">
        <input type="text" class="spell-search" placeholder="Search spells..." />
      </div>
      <a class="item-control item-create" data-type="spell" title="Create Spell">
        <i class="fas fa-plus"></i> Add Spell
      </a>
    </div>

    {{#each spellbook as |section level|}}
      <div class="spell-level-group" data-level="{{level}}">
        <div class="spell-level-header flexrow">
          <h3>{{section.label}}</h3>

          {{#if section.hasSlots}}
            <div class="spell-slots flexrow">
              <label>Slots:</label>
              <input type="number" name="system.spells.spell{{level}}.value" value="{{section.slots.value}}" data-dtype="Number" placeholder="0" />
              <span>/</span>
              <input type="number" name="system.spells.spell{{level}}.max" value="{{section.slots.max}}" data-dtype="Number" placeholder="0" />
            </div>
          {{/if}}
        </div>

        <ul class="item-list spell-list">
          <li class="item-header flexrow">
            <span class="item-name">Name</span>
            <span class="item-detail">Cast Time</span>
            <span class="item-detail">Range</span>
            <span class="item-detail">Components</span>
            <span class="item-controls">Actions</span>
          </li>

          {{#each section.spells as |spell|}}
            <li class="item flexrow" data-item-id="{{spell._id}}">
              
              {{!-- Name & Preparation Toggle --}}
              <div class="item-name flexrow">
                <a class="item-control item-toggle-prep {{#if spell.system.prepared.value}}prepared{{/if}}" title="Toggle Preparation">
                  <i class="fas {{#if spell.system.prepared.value}}fa-check-circle{{else}}fa-circle{{/if}}"></i>
                </a>
                <div class="item-image" style="background-image: url('{{spell.img}}')"></div>
                <h4 class="spell-roll-trigger">{{spell.name}}</h4>
              </div>

              {{!-- Details --}}
              <span class="item-detail">{{spell.system.activation.cost}} {{spell.system.activation.type}}</span>
              <span class="item-detail">{{spell.system.range.value}} {{spell.system.range.units}}</span>
              <span class="item-detail">
                {{#if spell.system.components.v}}V {{/if}}
                {{#if spell.system.components.s}}S {{/if}}
                {{#if spell.system.components.m}}M {{/if}}
              </span>

              {{!-- Action Icons --}}
              <div class="item-controls flexrow">
                <a class="item-control item-edit" title="Edit Spell"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete Spell"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}

          {{#unless section.spells.length}}
            <li class="item flexrow empty-section">
              <span>No {{section.label}} known.</span>
            </li>
          {{/unless}}
        </ul>
      </div>
    {{/each}}
  </section>

</form>
