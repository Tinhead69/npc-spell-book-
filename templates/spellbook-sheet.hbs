<form class="{{cssClass}} flexcol dnd5e2 sheet item" autocomplete="off" style="background: #1a1a1a; color: #f0f0f0; padding: 8px;">
  <!-- Header / Action Buttons -->
  <header class="sheet-header flexrow" style="align-items: center; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #333; gap: 8px;">
    <img src="{{#if img}}{{img}}{{else}}icons/svg/book.svg{{/if}}" data-edit="img" alt="{{name}}" width="40" height="40" style="flex: 0 0 40px; border: 1px solid #444; border-radius: 4px; object-fit: contain; cursor: pointer; background: #111;" title="Click to change image" />
    <div style="flex: 1; font-size: 1.15rem; font-weight: bold; color: #ffffff;">{{name}}</div>
    <div style="display: flex; gap: 6px;">
      <button type="button" class="add-spell-btn" style="padding: 3px 10px; font-size: 0.8rem; background: #2b2b2b; border: 1px solid #444; border-radius: 3px; cursor: pointer; color: #fff;">
        <i class="fas fa-plus"></i> Add Spell
      </button>
      <button type="button" class="clear-book-btn" style="padding: 3px 8px; font-size: 0.8rem; background: #2b2b2b; border: 1px solid #444; border-radius: 3px; cursor: pointer; color: #ff8888;" title="Clear Spellbook">
        <i class="fas fa-trash"></i>
      </button>
    </div>
  </header>

  <!-- Spell List Body Grouped by Level -->
  <section class="sheet-body" style="flex: 1; overflow-y: auto; max-height: 520px;">
    <ol class="items-list inventory-list directory-list" style="list-style: none; padding: 0; margin: 0;">
      {{#if hasSpells}}
        {{#each activeLevels}}
          <!-- Matching Dark Wine-Red Character Sheet Header Bar -->
          <li class="item-header flexrow" style="background-color: #4a1519 !important; background: #4a1519 !important; color: #ffffff !important; padding: 4px 8px; font-weight: bold; font-size: 0.75rem; letter-spacing: 0.5px; margin-top: 8px; border-radius: 2px; align-items: center;">
            <div class="item-name" style="flex: 1; color: #ffffff;">{{label}}</div>
            <div class="item-detail" style="width: 75px; text-align: center; color: #ffffff;">ACTIVATION</div>
            <div class="item-detail" style="width: 65px; text-align: center; color: #ffffff;">RANGE</div>
            <div class="item-detail" style="width: 80px; text-align: center; color: #ffffff;">TARGET</div>
            <div class="item-detail" style="width: 55px; text-align: center; color: #ffffff;">COMP</div>
            <div class="item-detail" style="width: 75px; text-align: center; color: #ffffff;">DURATION</div>
            <div class="item-controls" style="width: 40px; text-align: right;"></div>
          </li>

          <ol class="item-list" style="list-style: none; padding: 0; margin: 2px 0 6px 0;">
            {{#each spells}}
              <li class="item flexrow" style="align-items: center; padding: 4px 6px; border-bottom: 1px solid #2a2a2a; background: #222222; border-radius: 2px;">
                <div class="item-name flexrow" style="flex: 1; align-items: center; gap: 8px;">
                  <img src="{{img}}" alt="{{name}}" width="28" height="28" style="width: 28px; height: 28px; flex: 0 0 28px; border: 1px solid #444; border-radius: 3px; object-fit: contain; background: #111;" />
                  <span class="spell-name" style="font-weight: 600; color: #f0f0f0; font-size: 0.9rem;">{{name}}</span>
                </div>
                <div class="item-detail" style="width: 75px; text-align: center; font-size: 0.85rem; color: #cccccc;" title="{{castTime}}">
                  {{castTime}}
                </div>
                <div class="item-detail" style="width: 65px; text-align: center; font-size: 0.85rem; color: #cccccc;" title="{{range}}">
                  {{range}}
                </div>
                <div class="item-detail" style="width: 80px; text-align: center; font-size: 0.85rem; color: #cccccc;" title="{{target}}">
                  {{target}}
                </div>
                <div class="item-detail" style="width: 55px; text-align: center; font-size: 0.85rem; color: #cccccc;" title="{{components}}">
                  {{components}}
                </div>
                <div class="item-detail" style="width: 75px; text-align: center; font-size: 0.85rem; color: #cccccc;" title="{{duration}}">
                  {{duration}}
                </div>
                <div class="item-controls" style="width: 40px; text-align: right;">
                  <button type="button" class="remove-spell-btn" data-uuid="{{uuid}}" style="background: none; border: none; cursor: pointer; color: #ff8888;" title="Remove Spell">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </li>
            {{/each}}
          </ol>
        {{/each}}
      {{else}}
        <p class="notes" style="text-align: center; padding: 2rem; color: #888888; font-style: italic;">This spellbook is empty. Click "Add Spell" to add spells.</p>
      {{/if}}
    </ol>
  </section>
</form>
