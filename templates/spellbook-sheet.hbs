<div class="npc-spellbook-sheet-body">
  <header class="sheet-header">
    <div class="header-top-row">
      <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" title="Change Spellbook Image" alt="{{item.name}}" />
      <div class="header-fields">
        <input class="item-name" name="name" type="text" value="{{item.name}}" placeholder="Spellbook Name" />
        <div class="header-actions">
          <button type="button" class="btn" data-action="addSpells">
            <i class="fas fa-plus"></i> Add Spell
          </button>
          <button type="button" class="btn" data-action="transcribeSpells">
            <i class="fas fa-scroll"></i> Transcribe
          </button>
          <button type="button" class="btn clear-spellbook-btn" data-action="clearSpellbook">
            <i class="fas fa-trash"></i> Clear
          </button>
        </div>
      </div>
    </div>
  </header>

  <div class="spellbook-body">
    {{#if spellGroups.length}}
      {{#each spellGroups}}
        <section class="level-group{{#if this.collapsed}} collapsed{{/if}}" data-level="{{this.level}}">
          <button type="button" class="level-header spell-grid-row" data-action="toggleLevel" data-level="{{this.level}}" aria-expanded="{{#unless this.collapsed}}true{{else}}false{{/unless}}">
            <div class="col-name level-title">
              <i class="fas fa-chevron-down level-chevron" aria-hidden="true"></i>
              <span>{{this.label}}</span>
            </div>
            <div class="col-time">Casting Time</div>
            <div class="col-range">Range</div>
            <div class="col-duration">Duration</div>
            <div class="col-target">Target</div>
            <div class="col-components">Components</div>
            <div class="col-actions"></div>
          </button>

          <div class="spell-list">
            {{#each this.spells}}
              <div class="spell-row spell-grid-row" data-uuid="{{this.uuid}}" data-spell-tooltip="1">
                <div class="col-name">
                  <img class="spell-icon" src="{{this.img}}" alt="" />
                  <div class="spell-details">
                    <span class="spell-title">{{this.name}}</span>
                  </div>
                </div>
                <div class="col-time">{{this.castingTime}}</div>
                <div class="col-range">{{this.range}}</div>
                <div class="col-duration">{{this.duration}}</div>
                <div class="col-target">{{this.target}}</div>
                <div class="col-components">{{this.components}}</div>
                <div class="col-actions">
                  <a class="spell-delete" data-action="deleteSpell" data-uuid="{{this.uuid}}" title="Remove Spell">
                    <i class="fas fa-trash"></i>
                  </a>
                </div>
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    {{else}}
      <div class="empty-notice">No spells recorded. Use Add Spell to populate this book.</div>
    {{/if}}
  </div>
</div>
