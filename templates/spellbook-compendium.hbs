<div class="spell-picker-container" style="display: flex; flex-direction: column; height: 100%; font-family: sans-serif; overflow: hidden; background: #1a1a1a; color: #fff;">
  <style>
    .spell-picker .window-content,
    form.spell-picker {
      height: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      overflow: hidden !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  </style>

  <!-- Spells List Container -->
  <div style="flex: 1; overflow-y: auto; padding: 8px;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
      <thead>
        <tr style="border-bottom: 1px solid #444; color: #888; text-align: left;">
          <th style="padding: 6px;">Spell</th>
          <th style="padding: 6px; text-align: center;">Level</th>
          <th style="padding: 6px;">Compendium Source</th>
          <th style="padding: 6px; text-align: center; width: 60px;"></th>
        </tr>
      </thead>
      <tbody>
        {{#each spells}}
          <tr style="border-bottom: 1px solid #2a2a2a;">
            <td style="padding: 4px; vertical-align: middle;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <img src="{{img}}" width="20" height="20" style="border: none; border-radius: 2px;" />
                <span style="font-weight: 500;">{{name}}</span>
              </div>
            </td>
            <td style="padding: 4px; text-align: center; color: #ccc; vertical-align: middle;">
              {{#if level}}Level {{level}}{{else}}Cantrip{{/if}}
            </td>
            <td style="padding: 4px; color: #888; font-size: 0.75rem; vertical-align: middle;">
              {{pack}}
            </td>
            <td style="padding: 4px; text-align: center; vertical-align: middle;">
              <button type="button" data-action="addSpell" data-uuid="{{uuid}}" style="background: #3a5a3a; color: #fff; border: 1px solid #5a8a5a; border-radius: 3px; padding: 2px 8px; cursor: pointer; font-size: 0.75rem;">
                + Add
              </button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
