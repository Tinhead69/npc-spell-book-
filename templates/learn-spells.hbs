<div class="study-spellbook-wrapper">
  <!-- Wizard Selector Row -->
  <div class="wizard-select">
    <h3>Select Wizard</h3>
    <ul class="wizard-list flexrow">
      {{#each wizards}}
        <li>
          <button type="button" 
                  class="btn {{#if this.selected}}active{{/if}}" 
                  data-action="selectWizard" 
                  data-wizard-id="{{this.id}}">
            <i class="fas fa-hat-wizard"></i> {{this.name}}
          </button>
        </li>
      {{/each}}
    </ul>
  </div>

  {{#if hasWizard}}
    <div class="wizard-summary">
      <span><strong>Level:</strong> {{wizardLevel}}</span> | 
      <span><strong>Max Spell Level:</strong> {{maxLevel}}</span>
    </div>

    <!-- Sorting Bar -->
    <div class="study-toolbar flexrow">
      <span class="sort-label">Sort By:</span>
      <div class="btn-group flexrow">
        <button type="button" 
                class="btn sort-btn {{#if (eq currentSort 'level')}}active{{/if}}" 
                data-action="sortSpells" 
                data-sort="level">
          <i class="fas fa-layer-group"></i> Level
        </button>

        <button type="button" 
                class="btn sort-btn {{#if (eq currentSort 'name')}}active{{/if}}" 
                data-action="sortSpells" 
                data-sort="name">
          <i class="fas fa-sort-alpha-down"></i> Name
        </button>

        <button type="button" 
                class="btn sort-btn {{#if (eq currentSort 'availability')}}active{{/if}}" 
                data-action="sortSpells" 
                data-sort="availability">
          <i class="fas fa-check-circle"></i> Available
        </button>
      </div>
    </div>

    <!-- Column Headers -->
    <div class="spell-header flexrow">
      <span class="column-title item-name">SPELL</span>
      <span class="column-title study-cost">COST</span>
      <span class="column-title study-time">TIME</span>
      <span class="column-title study-status">STATUS / ACTION</span>
    </div>

    <!-- Spell List -->
    <ul class="study-list">
      {{#each spells}}
        <li class="study-entry flexrow {{#unless this.canLearn}}blocked{{/unless}}" data-spell-uuid="{{this.uuid}}">
          <div class="item-name">
            <img src="{{this.img}}" width="32" height="32" />
            <div class="name-container">
              <span class="spell-name">{{this.name}}</span>
              <span class="spell-level">Level {{this.level}}</span>
            </div>
          </div>
          <div class="study-cost">Cost: {{this.cost}} gp</div>
          <div class="study-time">Time: {{this.hours}} hours</div>
          <div class="study-status">
            {{#if this.canLearn}}
              <button type="button" class="btn transcribe-btn" data-action="transcribe">
                Transcribe
              </button>
            {{else}}
              <span class="status-reason">{{this.statusLabel}}</span>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</div>
