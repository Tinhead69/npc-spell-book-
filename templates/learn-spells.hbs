<div class="study-spellbook-content">
  <!-- Wizard Selection Header -->
  <div class="study-header flexrow">
    <label class="wizard-label">{{localize "NPC_SPELLBOOK.Learn.WizardSelect"}}</label>
    <div class="wizard-selector flexrow">
      {{#each wizards}}
        <button type="button" 
                class="btn wizard-btn {{#if this.selected}}active{{/if}}" 
                data-action="selectWizard" 
                data-wizard-id="{{this.id}}">
          <i class="fas fa-hat-wizard"></i> {{this.name}}
        </button>
      {{/each}}
    </div>
  </div>

  {{#if hasWizard}}
    <!-- Wizard Stats Bar -->
    <div class="wizard-stats flexrow">
      <span><strong>Level:</strong> {{wizardLevel}}</span>
      <span><strong>Max Spell Level:</strong> {{maxLevel}}</span>
    </div>

    <!-- Sort Toolbar -->
    <div class="study-toolbar flexrow">
      <span class="sort-label">Sort By:</span>
      <div class="btn-group flexrow">
        <button type="button" 
                class="btn sort-btn {{#if (eq currentSort 'level')}}active{{/if}}" 
                data-action="sortSpells" 
                data-sort="level">
          <i class="fas fa-layer-group"></i> Level
        </button>

        <button type="button" 
                class="btn sort-btn {{#if (eq currentSort 'name')}}active{{/if}}" 
                data-action="sortSpells" 
                data-sort="name">
          <i class="fas fa-sort-alpha-down"></i> Name
        </button>

        <button type="button" 
                class="btn sort-btn {{#if (eq currentSort 'availability')}}active{{/if}}" 
                data-action="sortSpells" 
                data-sort="availability">
          <i class="fas fa-check-circle"></i> Available
        </button>
      </div>
    </div>

    <!-- Spells Table -->
    <div class="spells-container">
      <ol class="spells-list">
        {{#each spells}}
          <li class="spell-row flexrow {{#unless this.canLearn}}disabled{{/unless}}" data-spell-uuid="{{this.uuid}}">
            <div class="spell-image">
              <img src="{{this.img}}" title="{{this.name}}" width="32" height="32" />
            </div>
            <div class="spell-name flexcol">
              <span class="name">{{this.name}}</span>
              <span class="status-reason">{{this.statusLabel}}</span>
            </div>
            <div class="spell-level">Lvl {{this.level}}</div>
            <div class="spell-cost">{{this.cost}} gp / {{this.hours}} hrs</div>
            <div class="spell-actions">
              <button type="button" 
                      class="btn transcribe-btn" 
                      data-action="transcribe" 
                      {{#unless this.canLearn}}disabled{{/unless}}>
                Transcribe
              </button>
            </div>
          </li>
        {{/each}}
      </ol>
    </div>
  {{else}}
    <p class="notes">{{localize "NPC_SPELLBOOK.Learn.NoWizards"}}</p>
  {{/if}}
</div>
