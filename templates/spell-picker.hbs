<div class="spell-picker-root">
  <aside class="spell-picker-sidebar">
    <section class="spell-picker-filters">
      <div class="spell-picker-section-title">
        <i class="fas fa-filter"></i> Spell Filters
      </div>

      <div class="spell-picker-rules">
        <div class="spell-picker-col-title">Rules Version</div>
        <div class="spell-picker-rules-options">
          {{#each rulesOptions}}
            <label class="spell-picker-check rules-check">
              <input type="radio" name="rulesVersion" data-action="setRulesVersion" data-rules="{{this.id}}" {{#if this.selected}}checked{{/if}} />
              <span>{{this.label}}</span>
            </label>
          {{/each}}
        </div>
      </div>

      <div class="spell-picker-filter-columns">
        <div class="spell-picker-filter-col">
          <div class="spell-picker-col-title">
            <span>Level</span>
            <button type="button" class="spell-picker-select-all" data-action="toggleAllLevels" data-mode="{{#if levelsAllSelected}}deselect{{else}}select{{/if}}">
              {{#if levelsAllSelected}}Deselect All{{else}}Select All{{/if}}
            </button>
          </div>
          {{#each levels}}
            <label class="spell-picker-check" data-action="toggleLevel" data-level="{{this.level}}">
              <input type="checkbox" tabindex="-1" {{#if this.selected}}checked{{/if}} />
              <span>{{this.label}}</span>
            </label>
          {{/each}}
        </div>
        <div class="spell-picker-filter-col">
          <div class="spell-picker-col-title">
            <span>School</span>
            <button type="button" class="spell-picker-select-all" data-action="toggleAllSchools" data-mode="{{#if schoolsAllSelected}}deselect{{else}}select{{/if}}">
              {{#if schoolsAllSelected}}Deselect All{{else}}Select All{{/if}}
            </button>
          </div>
          {{#each schools}}
            <label class="spell-picker-check" data-action="toggleSchool" data-school="{{this.id}}" title="{{this.label}}">
              <input type="checkbox" tabindex="-1" {{#if this.selected}}checked{{/if}} />
              <span>{{this.label}}</span>
            </label>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="spell-picker-compendiums">
      <div class="spell-picker-section-title">
        <span><i class="fas fa-atlas"></i> Compendiums</span>
        <button type="button" class="spell-picker-select-all" data-action="toggleAllPacks" data-mode="{{#if packsAllSelected}}deselect{{else}}select{{/if}}">
          {{#if packsAllSelected}}Deselect All{{else}}Select All{{/if}}
        </button>
      </div>
      <div class="spell-picker-pack-list">
        {{#if packs.length}}
          {{#each packs}}
            <label class="spell-picker-check pack-check" data-action="togglePack" data-pack="{{this.id}}" data-pack-ids="{{this.packIds}}" title="{{this.title}}">
              <input type="checkbox" tabindex="-1" {{#if this.selected}}checked{{/if}} />
              <span>{{this.label}}</span>
            </label>
          {{/each}}
        {{else}}
          <div class="spell-picker-empty-side">No spell compendiums found.</div>
        {{/if}}
      </div>
    </section>
  </aside>

  <main class="spell-picker-main">
    <div class="spell-picker-toolbar">
      <i class="fas fa-search"></i>
      {{!-- value is set in JS so search re-filters do not recreate this input --}}
      <input type="text" name="searchQuery" placeholder="Search spell name..." data-search-input autocomplete="off" />
      <span class="spell-picker-count" data-spell-count>{{spellCount}} Spells Found</span>
    </div>

    <div class="spell-picker-scroll-container" data-spell-results></div>
  </main>
</div>
