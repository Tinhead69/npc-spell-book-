<div class="standard-form compendium-spell-picker-container flexcol">
  <!-- Controls Section -->
  <header class="wizard-selection-header flexcol" style="gap: 0.5rem; padding: 0.5rem; background: rgba(0,0,0,0.2); border-radius: 4px;">
    <div class="flexrow" style="gap: 0.5rem; align-items: center;">
      <label for="pack-select"><strong>Compendium:</strong></label>
      <select id="pack-select" style="flex: 1;">
        {{#each packs}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="flexrow" style="gap: 0.5rem; align-items: center;">
      <label for="level-select"><strong>Spell Level:</strong></label>
      <select id="level-select" style="flex: 1;">
        {{#each levels}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
  </header>

  <!-- Spell List Table -->
  <div class="spell-list-container flexcol" style="margin-top: 0.5rem; max-height: 450px; overflow-y: auto;">
    {{#if hasSpells}}
      <table class="spell-picker-table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--color-border-light); text-align: left;">
            <th style="padding: 6px; width: 36px;"></th>
            <th style="padding: 6px;">Spell Name</th>
            <th style="padding: 6px; width: 90px;">School</th>
            <th style="padding: 6px; width: 90px;">Time</th>
            <th style="padding: 6px; width: 90px;">Range</th>
            <th style="padding: 6px; width: 90px;">Duration</th>
            <th style="padding: 6px; width: 70px; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each spells}}
            <tr style="border-bottom: 1px solid var(--color-border-light-2);">
              <td style="padding: 4px;">
                <img src="{{img}}" alt="{{name}}" width="28" height="28" style="border: none; border-radius: 4px; vertical-align: middle;">
              </td>
              <td style="padding: 4px; font-weight: bold; vertical-align: middle;">
                {{name}}
              </td>
              <td style="padding: 4px; vertical-align: middle; opacity: 0.8;">
                {{school}}
              </td>
              <td style="padding: 4px; vertical-align: middle; opacity: 0.8;">
                {{time}}
              </td>
              <td style="padding: 4px; vertical-align: middle; opacity: 0.8;">
                {{range}}
              </td>
              <td style="padding: 4px; vertical-align: middle; opacity: 0.8;">
                {{duration}}
              </td>
              <td style="padding: 4px; text-align: right; vertical-align: middle;">
                {{#if inBook}}
                  <span style="font-size: 0.75rem; opacity: 0.6; font-style: italic;">In Book</span>
                {{else}}
                  <button type="button" class="add-picker-spell-btn transcribe-btn" data-uuid="{{uuid}}" style="padding: 2px 6px; font-size: 0.8rem;">
                    <i class="fas fa-plus"></i> Add
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p class="empty-notice" style="text-align: center; padding: 1rem;">No matching spells found in this compendium.</p>
    {{/if}}
  </div>
</div>
