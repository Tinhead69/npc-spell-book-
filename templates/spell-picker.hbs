<div class="compendium-spell-picker-container" style="display: flex; height: 100%; width: 100%; background: #181818; color: #f0f0f0; font-family: sans-serif; overflow: hidden;">
  
  <!-- LEFT SIDEBAR -->
  <aside style="width: 320px; min-width: 320px; border-right: 1px solid #333; display: flex; flex-direction: column; background: #121212;">
    
    <!-- TOP LEFT: LEVEL AND SCHOOL SORTING/FILTERING -->
    <div style="flex: 1; padding: 10px; border-bottom: 1px solid #333; overflow-y: auto;">
      <div style="font-weight: bold; font-size: 0.85rem; color: #d1b87a; border-bottom: 1px solid #444; padding-bottom: 4px; margin-bottom: 8px; text-transform: uppercase;">
        <i class="fas fa-filter"></i> Spell Filters
      </div>

      <div style="display: flex; gap: 12px;">
        <!-- Column 1: Spell Levels (1-9) -->
        <div style="flex: 1;">
          <div style="font-weight: bold; font-size: 0.75rem; color: #aaa; margin-bottom: 4px;">LEVEL</div>
          <div style="display: flex; flex-direction: column; gap: 3px;">
            {{#each levels}}
              <label style="font-size: 0.75rem; display: flex; align-items: center; gap: 6px; cursor: pointer; user-select: none;">
                <input type="checkbox" data-action="toggleLevel" data-level="{{this.level}}" {{#if this.selected}}checked{{/if}} style="margin: 0; cursor: pointer;" />
                <span>{{this.label}}</span>
              </label>
            {{/each}}
          </div>
        </div>

        <!-- Column 2: Schools of Magic -->
        <div style="flex: 1;">
          <div style="font-weight: bold; font-size: 0.75rem; color: #aaa; margin-bottom: 4px;">SCHOOL</div>
          <div style="display: flex; flex-direction: column; gap: 3px;">
            {{#each schools}}
              <label style="font-size: 0.75rem; display: flex; align-items: center; gap: 6px; cursor: pointer; user-select: none;" title="{{this.label}}">
                <input type="checkbox" data-action="toggleSchool" data-school="{{this.id}}" {{#if this.selected}}checked{{/if}} style="margin: 0; cursor: pointer;" />
                <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{this.label}}</span>
              </label>
            {{/each}}
          </div>
        </div>
      </div>
    </div>

    <!-- BOTTOM LEFT: INSTALLED COMPENDIUMS LIST -->
    <div style="flex: 1; padding: 10px; overflow-y: auto; background: #0f0f0f;">
      <div style="font-weight: bold; font-size: 0.85rem; color: #d1b87a; border-bottom: 1px solid #444; padding-bottom: 4px; margin-bottom: 8px; text-transform: uppercase;">
        <i class="fas fa-atlas"></i> Compendiums
      </div>
      <div style="display: flex; flex-direction: column; gap: 4px;">
        {{#each packs}}
          <label style="font-size: 0.75rem; display: flex; align-items: center; gap: 6px; cursor: pointer; user-select: none; padding: 2px 4px; border-radius: 3px; background: #1a1a1a;" title="{{this.label}} ({{this.id}})">
            <input type="checkbox" data-action="togglePack" data-pack="{{this.id}}" {{#if this.selected}}checked{{/if}} style="margin: 0; cursor: pointer;" />
            <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1;">{{this.label}}</span>
          </label>
        {{/each}}
      </div>
    </div>

  </aside>

  <!-- RIGHT PANEL: SPELL LIST & SEARCH -->
  <main style="flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #181818;">
    
    <!-- Search Bar -->
    <div style="padding: 8px 12px; border-bottom: 1px solid #333; background: #202020; display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
      <i class="fas fa-search" style="color: #888;"></i>
      <input type="text" data-action="searchSpells" value="{{searchQuery}}" placeholder="Search spell name..." style="flex: 1; background: #111; border: 1px solid #444; color: #fff; padding: 4px 8px; border-radius: 3px; font-size: 0.85rem;" />
      <span style="font-size: 0.75rem; color: #888;">{{spellCount}} Spells Found</span>
    </div>

    <!-- Spells Table Container -->
    <div style="flex: 1; overflow-y: auto; padding: 8px;">
      {{#if hasSpells}}
        {{#each activeLevels}}
          <div style="margin-bottom: 12px;">
            <!-- Red Header Bar -->
            <div style="background-color: #3c1618; color: #fff; padding: 4px 8px; font-weight: bold; font-size: 0.8rem; border-radius: 3px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span>{{label}}</span>
              <span style="font-size: 0.7rem; opacity: 0.7;">{{spells.length}} Spells</span>
            </div>

            <!-- Spells List -->
            <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
              <thead>
                <tr style="color: #777; border-bottom: 1px solid #333; font-size: 0.75rem; text-align: left;">
                  <th style="padding: 4px;">Spell</th>
                  <th style="padding: 4px; text-align: center;">School</th>
                  <th style="padding: 4px; text-align: center;">Time</th>
                  <th style="padding: 4px; text-align: center;">Range</th>
                  <th style="padding: 4px; text-align: center;">Target</th>
                  <th style="padding: 4px; text-align: right; width: 60px;"></th>
                </tr>
              </thead>
              <tbody>
                {{#each spells}}
                  <tr style="border-bottom: 1px solid #262626;">
                    <td style="padding: 4px; vertical-align: middle;">
                      <div style="display: flex; align-items: center; gap: 6px;">
                        <img src="{{img}}" width="22" height="22" style="border: none; border-radius: 3px; object-fit: contain;" />
                        <span style="font-weight: 500; color: #eee;">{{name}}</span>
                      </div>
                    </td>
                    <td style="padding: 4px; text-align: center; color: #aaa; font-size: 0.75rem; vertical-align: middle;">{{schoolName}}</td>
                    <td style="padding: 4px; text-align: center; color: #aaa; font-size: 0.75rem; vertical-align: middle;">{{time}}</td>
                    <td style="padding: 4px; text-align: center; color: #aaa; font-size: 0.75rem; vertical-align: middle;">{{range}}</td>
                    <td style="padding: 4px; text-align: center; color: #aaa; font-size: 0.75rem; vertical-align: middle;">{{target}}</td>
                    <td style="padding: 4px; text-align: right; vertical-align: middle;">
                      {{#if inBook}}
                        <span style="font-size: 0.75rem; opacity: 0.5; font-style: italic;">Added</span>
                      {{else}}
                        <button type="button" data-action="addSpell" data-uuid="{{uuid}}" style="padding: 2px 8px; font-size: 0.75rem; background: #2b4c2b; color: #fff; border: 1px solid #4a7c4a; border-radius: 3px; cursor: pointer;">
                          <i class="fas fa-plus"></i> Add
                        </button>
                      {{/if}}
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{/each}}
      {{else}}
        <div style="text-align: center; padding: 40px; color: #777; font-style: italic;">
          No spells found matching selected filters.
        </div>
      {{/if}}
    </div>

  </main>
</div>
