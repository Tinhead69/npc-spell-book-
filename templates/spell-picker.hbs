<form class="standard-form compendium-spell-picker-container flexcol" autocomplete="off" style="padding: 6px; background: #191919; color: #f0f0f0; border: none;">
  <!-- Controls Section -->
  <header class="sheet-header flexrow" style="padding: 4px; align-items: center; margin-bottom: 8px; border: none;">
    <div class="form-group flexrow" style="gap: 8px; align-items: center; width: 100%;">
      <label for="pack-select" style="font-weight: bold; white-space: nowrap; color: #f0f0f0;">Compendium:</label>
      <select id="pack-select" style="flex: 1; background: #222; color: #fff; border: 1px solid #444;">
        {{#each packs}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
  </header>

  <!-- Spell List Body Grouped by Level with Matching Red Headers -->
  <section class="sheet-body" style="flex: 1; overflow-y: auto; max-height: 520px; border: none;">
    <ol class="items-list inventory-list directory-list" style="list-style: none; padding: 0; margin: 0;">
      {{#if hasSpells}}
        {{#each activeLevels}}
          <!-- Matching Dark Red Header Bar -->
          <li class="item-header flexrow" style="background-color: #3c1618 !important; background: #3c1618 !important; color: #fff !important; padding: 4px 8px; font-weight: bold; margin-top: 8px; border-radius: 3px; align-items: center; border: none;">
            <div class="item-name" style="flex: 1; color: #fff;">{{label}}</div>
            <div class="item-detail" style="width: 75px; text-align: center; color: #fff;">TIME</div>
            <div class="item-detail" style="width: 75px; text-align: center; color: #fff;">RANGE</div>
            <div class="item-detail" style="width: 90px; text-align: center; color: #fff;">TARGET</div>
            <div class="item-controls" style="width: 60px; text-align: right;"></div>
          </li>

          <ol class="item-list" style="list-style: none; padding: 0; margin: 2px 0 6px 0;">
            {{#each spells}}
              <li class="spell-row flexrow item" style="align-items: center; padding: 4px 6px; border-bottom: 1px solid #333;">
                <div class="item-name flexrow" style="flex: 1; align-items: center; gap: 8px;">
                  <img src="{{img}}" alt="{{name}}" width="28" height="28" style="width: 28px; height: 28px; flex: 0 0 28px; border: none; border-radius: 3px; object-fit: contain;" />
                  <span class="spell-name" style="font-weight: 500; color: #f0f0f0;">{{name}}</span>
                </div>
                <div class="item-detail" style="width: 75px; text-align: center; font-size: 0.85rem; opacity: 0.8;">
                  {{time}}
                </div>
                <div class="item-detail" style="width: 75px; text-align: center; font-size: 0.85rem; opacity: 0.8;">
                  {{range}}
                </div>
                <div class="item-detail" style="width: 90px; text-align: center; font-size: 0.85rem; opacity: 0.8;">
                  {{target}}
                </div>
                <div class="item-controls" style="width: 60px; text-align: right;">
                  {{#if inBook}}
                    <span style="font-size: 0.75rem; opacity: 0.6; font-style: italic; color: #aaa;">Added</span>
                  {{else}}
                    <button type="button" class="add-picker-spell-btn" data-uuid="{{uuid}}" style="padding: 2px 6px; font-size: 0.8rem; background: #222; color: #fff; border: 1px solid #444;">
                      <i class="fas fa-plus"></i> Add
                    </button>
                  {{/if}}
                </div>
              </li>
            {{/each}}
          </ol>
        {{/each}}
      {{else}}
        <p class="notes" style="text-align: center; padding: 2rem; opacity: 0.7; color: #bbb;">No spells found in this compendium.</p>
      {{/if}}
    </ol>
  </section>
</form>
