<div class="npc-spellbook-container flexcol">
  <header class="sheet-header flexrow">
    <img class="profile-img" src="{{#if item.img}}{{item.img}}{{else}}icons/svg/book.svg{{/if}}" data-edit="img" title="{{item.name}}"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Spellbook Name"/>
      </h1>
      <p class="notes">
        This spellbook is independent of character spellbooks. Wizards may transcribe spells using 5e 2014 rules.
      </p>
    </div>
  </header>

  <section class="sheet-body flexcol">
    <div class="sheet-actions flexrow">
      {{#if isGM}}
        <button type="button" class="add-spell"><i class="fas fa-plus"></i> Add Spell</button>
      {{/if}}
      <button type="button" class="study-spellbook" data-action="studySpellbook"><i class="fas fa-scroll"></i> Study Spellbook</button>
    </div>

    <div class="spells-list">
      {{#each spellLevels as |spells level|}}
        <div class="spell-level-block">
          <div class="spell-level-header">
            {{#if (eq level 0)}}Cantrips{{else}}Level {{level}}{{/if}}
          </div>
          <table class="spells-table">
            <thead>
              <tr>
                <th class="col-name">Name</th>
                <th class="col-time">Time</th>
                <th class="col-range">Range</th>
                <th class="col-target">Target</th>
                <th class="col-actions"></th>
              </tr>
            </thead>
            <tbody>
              {{#each spells as |spell|}}
                <tr class="spell-item" data-spell-id="{{spell.id}}">
                  <td class="col-name">
                    <div class="spell-name-cell">
                      <img src="{{spell.img}}" class="spell-icon" />
                      <div class="spell-details">
                        <span class="spell-title">{{spell.name}}</span>
                        {{#if spell.components}}
                          <span class="spell-components">{{spell.components}}</span>
                        {{/if}}
                      </div>
                    </div>
                  </td>
                  <td class="col-time">{{#if spell.activation.cost}}{{spell.activation.cost}} {{spell.activation.type}}{{else}}A{{/if}}</td>
                  <td class="col-range">{{#if spell.range.value}}{{spell.range.value}} {{spell.range.units}}{{else}}—{{/if}}</td>
                  <td class="col-target">{{#if spell.target.value}}{{spell.target.value}} {{spell.target.units}}{{else}}—{{/if}}</td>
                  <td class="col-actions">
                    <a class="delete-spell" data-spell-id="{{spell.id}}" title="Delete Spell">
                      <i class="fas fa-trash"></i>
                    </a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="empty-notice">No spells recorded in this spellbook yet. Drop spell items here to add them.</p>
      {{/each}}
    </div>
  </section>
</div>
